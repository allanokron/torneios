generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== USUÁRIOS ====================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  city         String?
  state        String?
  birthDate    DateTime?
  bio          String?
  avatarUrl    String?
  gameLevel    String?
  dominantHand String?
  asaasCustomerId String?  @unique // ID do cliente no Asaas
  platformRole String @default("USER") // USER, ADMIN, OWNER
  status       String @default("ACTIVE") // ACTIVE, DISABLED
  disabledAt   DateTime?
  disabledReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile                    Profile?
  memberships                TournamentMember[]
  ownedTournaments           Tournament[]        @relation("TournamentOwner")
  courts                     Court[]             @relation("CourtOwner")
  sentInvites                Invite[]            @relation("InviteSender")
  matchesHome                Match[]             @relation("HomeTeamPlayer")
  matchesAway                Match[]             @relation("AwayTeamPlayer")
  matchPhotos                MatchPhoto[]
  messages                   Message[]
  scheduleProposalsSent      ScheduleProposal[]  @relation("ProposalSender")
  scheduleProposalsReceived  ScheduleProposal[]  @relation("ProposalReceiver")
  rescheduleRequestsSent     RescheduleRequest[] @relation("RescheduleSender")
  rescheduleRequestsReceived RescheduleRequest[] @relation("RescheduleReceiver")
  penalties                  Penalty[]           @relation("PenaltyTarget")
  penaltiesApplied           Penalty[]           @relation("PenaltyAppliedBy")
  woGiven                    Match[]             @relation("WOGivenBy")
  woReceived                 Match[]             @relation("WOReceivedBy")
  contestationsSent          Contestation[]      @relation("ContestationSender")
  contestationsResolved      Contestation[]      @relation("ContestationResolver")
  rankings                   PlayerRanking[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  announcements              Announcement[]
  consents                   Consent[]
  lgpdRequests               LGPDRequest[]
  accountDeletions           AccountDeletion[]
  subscription               Subscription?
  organizerCredits           OrganizerTournamentCredit[]
  manualOrganizerAccess      ManualOrganizerAccess?
  payments                   Payment[]
  categoryTeamMemberships    CategoryTeamMember[]
  categoryTeamInvitesSent    CategoryTeamInvite[] @relation("CategoryTeamInviteSender")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== TORNEIOS ====================

model Tournament {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  coverImage           String?
  sport                String    @default("tennis")
  format               String    @default("points_ranking") // points_ranking, ranking_elimination
  knockoutQualifiers   Int?
  rankingPhaseStatus   String    @default("open") // open, closed
  knockoutLockedAt     DateTime?
  location             String?
  address              String?
  city                 String?
  state                String?
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  maxParticipants      Int?
  isPublic             Boolean   @default(true)
  inviteCode           String?   @unique
  status               String    @default("draft") // draft, registration_open, registration_closed, in_progress, finished
  visibilityStatus     String    @default("ACTIVE") // ACTIVE, DISABLED
  disabledAt           DateTime?
  disabledReason       String?
  ownerId              String
  owner                User      @relation("TournamentOwner", fields: [ownerId], references: [id])

  // Regras da competição
  setsPerMatch       Int     @default(3)
  setsToWin          Int     @default(2)
  setType            String  @default("standard") // standard, tiebreak_only
  hasTiebreak        Boolean @default(true)
  tiebreakScore      Int     @default(6)
  hasSuperTiebreak   Boolean @default(true)
  superTiebreakScore Int     @default(10)

  // Regras gerais
  defaultMatchDuration  Int     @default(120) // minutos
  woCriteria            String?
  delayTolerance        Int     @default(15) // minutos
  generalRules          String?
  termsOfResponsibility String?
  cancellationRules     String?

  // Regras de adiamento
  maxPostponements      Int     @default(3) // máximo de adiamentos por jogador
  postponementScope     String  @default("month") // "month" ou "tournament" - período de contagem

  // Finalização
  autoFinishOnFirstSubmission Boolean @default(false)

  // Pagamento
  registrationFee        Int?     // valor da inscrição em centavos (null = gratuita)
  paymentMethod          String?  @default("PIX") // fixo PIX
  pixExpirationMinutes   Int      @default(30)
  subscriptionRequired   Boolean  @default(true)

  // Fases do torneio
  rankingPhaseDays   Int?  // dias para a fase de ranking (round-robin)
  knockoutPhaseDays  Int?  // dias para a fase de mata-mata

  // Organizador
  isOrganizerPlayer Boolean @default(true) // se o organizador vai jogar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          TournamentMember[]
  invites          Invite[]
  courts           Court[]
  matches          Match[]
  bracketMatches   BracketMatch[]
  scoringConfig    ScoringConfig?
  tiebreakerConfig TiebreakerConfig?
  challengeConfig  ChallengeConfig?
  rankings         PlayerRanking[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
  payments         Payment[]
  categories       TournamentCategory[]
  organizerCredit OrganizerTournamentCredit? @relation("CreditTournament")
}

model TournamentMember {
  id           String     @id @default(cuid())
  role         String     @default("player") // player, organizer, admin
  status       String     @default("pending") // pending, accepted, rejected
  joinedAt     DateTime?
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pagamento
  paymentStatus String?   // NONE, AWAITING_PIX, PIX_GENERATED, PIX_EXPIRED, PAYMENT_CONFIRMED, CONFIRMED
  paymentId     String?
  amountPaid    Int?      // em centavos

  @@unique([tournamentId, userId])
}

// ==================== CATEGORIAS / MODALIDADES ====================

model TournamentCategory {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name      String
  sport     String @default("beach_volley") // tennis, beach_volley
  gender    String // male, female, mixed
  teamSize  String // individual, double, trio, quartet
  level     String // estreante, iniciante, intermediario, avancado, open
  format    String // group_ranking_knockout, group_knockout, double_elimination, ranking_knockout
  status    String @default("draft") // draft, registration_open, registration_closed, in_progress, finished

  enableSilverSeries Boolean @default(false)
  paymentMode        String  @default("manual") // manual, online
  registrationFee    Int?    // valor por atleta em centavos

  groupSize                 Int?
  goldQualifiersPerGroup    Int?
  silverQualifiersPerGroup  Int?
  goldQualifiersTotal       Int?
  silverQualifiersTotal     Int?
  oddGroupPolicy            String? // ranking_byes, fill_with_best_next_position

  setsPerMatch       Int @default(3)
  normalSetPoints    Int @default(21)
  tiebreakSetPoints  Int @default(15)
  minPointDifference Int @default(2)

  teams          CategoryTeam[]
  groups         CategoryGroup[]
  standings      CategoryStanding[]
  matches        CategoryMatch[]
  bracketMatches CategoryBracketMatch[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
}

model CategoryTeam {
  id         String             @id @default(cuid())
  categoryId String
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name      String
  seed      Int?
  status    String @default("pending") // pending, complete, confirmed, rejected
  createdBy String?

  members        CategoryTeamMember[]
  invites        CategoryTeamInvite[]
  groupEntries   CategoryGroupEntry[]
  standings      CategoryStanding[]
  homeMatches    CategoryMatch[] @relation("CategoryHomeTeam")
  awayMatches    CategoryMatch[] @relation("CategoryAwayTeam")
  bracketHome    CategoryBracketMatch[] @relation("CategoryBracketHomeTeam")
  bracketAway    CategoryBracketMatch[] @relation("CategoryBracketAwayTeam")
  bracketWinners CategoryBracketMatch[] @relation("CategoryBracketWinnerTeam")
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model CategoryTeamMember {
  id      String       @id @default(cuid())
  teamId  String
  team    CategoryTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  name          String?
  email         String?
  role          String  @default("player") // player, organizer_added
  status        String  @default("pending") // pending, accepted, declined
  paymentStatus String? // NONE, AWAITING_PIX, PIX_EXPIRED, CONFIRMED, MANUAL_CONFIRMED
  amountPaid    Int?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
}

model CategoryTeamInvite {
  id        String       @id @default(cuid())
  teamId    String
  team      CategoryTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User         @relation("CategoryTeamInviteSender", fields: [senderId], references: [id])

  email   String
  name    String?
  status  String @default("pending") // pending, accepted, declined, cancelled
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, email])
}

model CategoryGroup {
  id         String             @id @default(cuid())
  categoryId String
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name     String
  position Int
  status   String @default("draft") // draft, drawn, completed

  entries CategoryGroupEntry[]
  matches CategoryMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, position])
}

model CategoryGroupEntry {
  id      String        @id @default(cuid())
  groupId String
  group   CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId  String
  team    CategoryTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  position Int?

  @@unique([groupId, teamId])
}

model CategoryStanding {
  id         String             @id @default(cuid())
  categoryId String
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  teamId     String
  team       CategoryTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupId    String?

  position      Int
  series        String? // gold, silver
  points        Int @default(0)
  matchesPlayed Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  setsWon       Int @default(0)
  setsLost      Int @default(0)
  pointsWon     Int @default(0)
  pointsLost    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, teamId, series])
}

model CategoryMatch {
  id         String             @id @default(cuid())
  categoryId String
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  homeTeamId String
  homeTeam   CategoryTeam @relation("CategoryHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   CategoryTeam @relation("CategoryAwayTeam", fields: [awayTeamId], references: [id])

  groupId String?
  group   CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  status      String @default("pending_scheduling")
  phase       String @default("group") // group, ranking, knockout, double_elimination
  series      String? // gold, silver, main
  bracketSide String? // winners, losers, grand_final
  round       String?
  position    Int?

  scheduledAt DateTime?
  duration    Int @default(60)
  homeScore   Int?
  awayScore   Int?
  winnerTeamId String?
  endReason   String?

  sets         CategorySet[]
  bracketMatch CategoryBracketMatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model CategorySet {
  id          String        @id @default(cuid())
  matchId     String
  match       CategoryMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber   Int
  homePoints  Int
  awayPoints  Int
  isTiebreak  Boolean @default(false)

  @@unique([matchId, setNumber])
}

model CategoryBracketMatch {
  id         String             @id @default(cuid())
  categoryId String
  category   TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  round       Int
  position    Int
  roundName   String
  status      String @default("waiting")
  series      String? // gold, silver, main
  bracketSide String? // winners, losers, grand_final

  homeSeed   Int?
  awaySeed   Int?
  homeTeamId String?
  homeTeam   CategoryTeam? @relation("CategoryBracketHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId String?
  awayTeam   CategoryTeam? @relation("CategoryBracketAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerTeamId String?
  winnerTeam   CategoryTeam? @relation("CategoryBracketWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  homeSourceLabel String?
  awaySourceLabel String?
  winnerNextRound Int?
  winnerNextPosition Int?
  winnerNextSlot String?
  loserNextRound Int?
  loserNextPosition Int?
  loserNextSlot String?

  matchId String? @unique
  match   CategoryMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, series, bracketSide, round, position])
}

// ==================== CONVITES ====================

model Invite {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation("InviteSender", fields: [senderId], references: [id])
  email        String
  status       String     @default("pending") // pending, accepted, rejected
  message      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, email])
}

// ==================== QUADRAS ====================

model Court {
  id           String     @id @default(cuid())
  name         String
  number       Int?
  surfaceType  String?
  isCovered    Boolean    @default(false)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User       @relation("CourtOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilities    CourtAvailability[]
  blockedSlots      CourtBlock[]
  reservations      Reservation[]
  matches           Match[]
  scheduleProposals ScheduleProposal[]
}

model CourtAvailability {
  id        String @id @default(cuid())
  courtId   String
  court     Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Domingo, 1=Segunda, etc.
  startTime String // "07:00"
  endTime   String // "22:00"

  @@unique([courtId, dayOfWeek])
}

model CourtBlock {
  id        String    @id @default(cuid())
  courtId   String
  court     Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime?
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime  @default(now())
}

// ==================== PARTIDAS ====================

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  homePlayerId String
  homePlayer   User   @relation("HomeTeamPlayer", fields: [homePlayerId], references: [id])
  awayPlayerId String
  awayPlayer   User   @relation("AwayTeamPlayer", fields: [awayPlayerId], references: [id])

  courtId String?
  court   Court?  @relation(fields: [courtId], references: [id])

  scheduledAt DateTime?
  duration    Int       @default(120) // minutos

  status String @default("pending_scheduling") // pending_scheduling, proposal_sent, awaiting_response, scheduled, reschedule_requested, in_progress, awaiting_result, finished, cancelled, wo, under_review
  phase  String @default("ranking") // ranking, knockout

  homeScore Int?
  awayScore Int?
  winnerId  String?

  endReason String? // normal, forfeit, wo

  woGivenBy    User? @relation("WOGivenBy", fields: [woGivenById], references: [id])
  woReceivedBy User? @relation("WOReceivedBy", fields: [woReceivedById], references: [id])

  startedAt  DateTime?
  finishedAt DateTime?

  // Fotos
  startPhotoUrl String?
  endPhotoUrl   String?

  // W.O.
  woGivenById    String?
  woReceivedById String?
  woReason       String?

  // Round & Month (for spreadsheet import)
  round String?
  month String?

  // Jogo Desafio
  isChallenge              Boolean @default(false)
  challengePositionHome    Int?
  challengePositionAway    Int?
  challengePoints          Int?
  challengePointsChallenged Int?
  challengeReferenceMonth  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets               Set[]
  scheduleProposals  ScheduleProposal[]
  rescheduleRequests RescheduleRequest[]
  reservations       Reservation[]
  photos             MatchPhoto[]
  messages           Message[]
  penalties          Penalty[]
  contestations      Contestation[]
  bracketMatch       BracketMatch?

  @@unique([tournamentId, homePlayerId, awayPlayerId, round])
}

model BracketMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round     Int
  position  Int
  roundName String
  status    String @default("waiting") // waiting, ready, bye, completed

  homeSeed     Int?
  awaySeed     Int?
  homePlayerId String?
  awayPlayerId String?
  winnerId     String?

  homeSourceLabel String?
  awaySourceLabel String?
  nextRound       Int?
  nextPosition    Int?
  nextSlot        String? // home, away

  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, round, position])
}

model Set {
  id              String  @id @default(cuid())
  matchId         String
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber       Int
  homeGames       Int
  awayGames       Int
  isTiebreak      Boolean @default(false)
  isSuperTiebreak Boolean @default(false)

  @@unique([matchId, setNumber])
}

// ==================== AGENDAMENTO ====================

model ScheduleProposal {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User   @relation("ProposalSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ProposalReceiver", fields: [receiverId], references: [id])

  proposedDate DateTime
  proposedTime String
  courtId      String
  court        Court  @relation(fields: [courtId], references: [id])
  message      String?

  status          String  @default("pending") // pending, accepted, rejected, counter_proposal
  responseMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RescheduleRequest {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User   @relation("RescheduleSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("RescheduleReceiver", fields: [receiverId], references: [id])

  newDate    DateTime
  newTime    String
  newCourtId String
  reason     String

  status String @default("pending") // pending, accepted, rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  courtId String
  court   Court  @relation(fields: [courtId], references: [id])

  startTime DateTime
  endTime   DateTime

  isConfirmed Boolean @default(false)
  isCancelled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== COMUNICAÇÃO ====================

model MatchPhoto {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  type      String // start, end
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
}

// ==================== PONTUAÇÃO E RANKING ====================

model ScoringConfig {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  winWithoutLosingSet   Int @default(3)
  winLosingOneSet       Int @default(2)
  lossWinningOneSet     Int @default(1)
  lossWithoutWinningSet Int @default(0)
  winByWO               Int @default(3)
  lossByWO              Int @default(0)
  woWinSets             Int @default(2)
  woLossSets            Int @default(0)
  woWinGames            Int @default(12)
  woLossGames           Int @default(0)
  winByForfeit          Int @default(3)
  lossByForfeit         Int @default(0)
  withdrawalPenalty     Int @default(-1)
  delayPenalty          Int @default(-1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TiebreakerConfig {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  criteriaOrder Json // Array ordenado: ["points", "sets_won", "games_balance", "direct_confrontation"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChallengeConfig {
  id           String     @id @default(cuid())
  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  enabled                   Boolean @default(false)
  rankingReference          String  @default("previous_month") // "previous_month" | "current"
  maxPositionsAhead         Int     @default(0) // 0 = ilimitado
  pointsPerPosition         Int     @default(50)

  challengerWinMultiplier   Float   @default(1.0)
  challengerLossMultiplier  Float   @default(1.0)
  challengedWinMultiplier   Float   @default(0.5)
  challengedLossMultiplier  Float   @default(0)

  countWins                 Boolean @default(false)
  countSets                 Boolean @default(false)
  countGames                Boolean @default(false)
  showChallengeColumn       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerRanking {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  position      Int
  points        Int @default(0)
  basePoints    Int @default(0)
  matchesPlayed Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  winsByWO      Int @default(0)
  lossesByWO    Int @default(0)
  setsWon       Int @default(0)
  setsLost      Int @default(0)
  gamesWon      Int @default(0)
  gamesLost     Int @default(0)

  // Critérios de desempate
  directConfrontation Int?
  setBalance          Int?
  gamesBalance        Int?

  // Estatísticas de desafio
  challengePoints   Int @default(0)
  challengeMatches  Int @default(0)
  challengeWins     Int @default(0)
  challengeLosses   Int @default(0)

  // Estatísticas de W.O.
  woPointsWon   Int @default(0)
  woPointsLost  Int @default(0)
  woSetsWon     Int @default(0)
  woSetsLost    Int @default(0)
  woGamesWon    Int @default(0)
  woGamesLost   Int @default(0)

  lastResults Json? // Array dos últimos resultados

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, userId])
}

// ==================== PENALIDADES E W.O. ====================

model Penalty {
  id           String  @id @default(cuid())
  tournamentId String
  userId       String
  user         User    @relation("PenaltyTarget", fields: [userId], references: [id])
  matchId      String?
  match        Match?  @relation(fields: [matchId], references: [id])

  type        String // withdrawal, delay, manual
  points      Int
  reason      String
  appliedById String
  appliedBy   User   @relation("PenaltyAppliedBy", fields: [appliedById], references: [id])

  createdAt DateTime @default(now())
}

model Contestation {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("ContestationSender", fields: [senderId], references: [id])

  reason      String
  description String
  imageUrl    String?

  status     String  @default("pending") // pending, resolved
  resolution String?
  resolverId String?
  resolver   User?   @relation("ContestationResolver", fields: [resolverId], references: [id])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ==================== NOTIFICAÇÕES ====================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    String // invite, match, scheduling, result, ranking, announcement
  link    String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== COMUNICADOS ====================

model Announcement {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])

  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== HISTÓRICO DE AUDITORIA ====================

model AuditLog {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String?

  oldValue Json?
  newValue Json?
  reason   String?

  ipAddress String?
  createdAt DateTime @default(now())
}

// ==================== LGPD / JURÍDICO ====================

model LegalDocument {
  id        String   @id @default(cuid())
  slug      String   @unique // privacy-policy, terms-of-use, cookies, payments, cancellation, security, lgpd
  title     String
  content   String   @db.Text
  version   String   @default("1.0")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents Consent[]
}

model Consent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId   String
  document     LegalDocument @relation(fields: [documentId], references: [id])
  documentSlug String
  documentTitle String
  documentVersion String
  accepted     Boolean  @default(true)
  ipAddress    String?
  userAgent    String?
  os           String?
  device       String?
  language     String?
  createdAt    DateTime @default(now())

  @@unique([userId, documentSlug, documentVersion])
}

model LGPDRequest {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  cpf       String?
  type      String   // access, correction, deletion, portability, revocation, information, other
  message   String   @db.Text
  status    String   @default("pending") // pending, in_progress, completed, rejected
  response  String?  @db.Text
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountDeletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  status    String   @default("pending") // pending, completed, rejected
  ipAddress String?
  createdAt DateTime @default(now())
  completedAt DateTime?
}

// ==================== PAGAMENTOS / ASAAS ====================

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String?
  plan                  OrganizerPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  asaasCustomerId       String?
  asaasSubscriptionId   String?
  status                String   @default("INACTIVE") // INACTIVE, ACTIVE, SUSPENDED, PAST_DUE, CANCELLED
  monthlyValue          Decimal  @default(9.90)
  nextBillingDate       DateTime?
  tournamentCreditsUsed Int      @default(0) // quantos dos 2 inclusos foram usados
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OrganizerPlan {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  description           String?
  monthlyValue          Int
  tournamentLimit       Int?     // null = ilimitado
  features              Json?
  isActive              Boolean  @default(true)
  subscriptions         Subscription[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OrganizerTournamentCredit {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId    String?     @unique
  payment      Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  tournamentId String?     @unique
  tournament   Tournament? @relation("CreditTournament", fields: [tournamentId], references: [id], onDelete: SetNull)
  status       String      @default("AVAILABLE") // PENDING_PAYMENT, AVAILABLE, USED, CANCELLED
  value        Int         @default(4990)
  usedAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status])
}

model ManualOrganizerAccess {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  reason    String?
  grantedBy String?
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  tournamentId      String?
  tournament        Tournament? @relation(fields: [tournamentId], references: [id])
  categoryId        String?
  category          TournamentCategory? @relation(fields: [categoryId], references: [id])
  teamId            String?
  team              CategoryTeam? @relation(fields: [teamId], references: [id])
  teamMemberId      String?
  teamMember        CategoryTeamMember? @relation(fields: [teamMemberId], references: [id])
  type              String   // SUBSCRIPTION, TOURNAMENT_EXTRA, REGISTRATION
  asaasPaymentId    String?  @unique
  asaasCustomerId   String?
  billingType       String   @default("PIX") // PIX, CREDIT_CARD
  value             Int      // em centavos
  status            String   @default("PENDING") // PENDING, AWAITING_PIX, PAID, OVERDUE, REFUNDED, CANCELLED
  description       String?
  externalReference String?
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organizerCredit   OrganizerTournamentCredit?
}

model WebhookEvent {
  id            String   @id @default(cuid())
  asaasEventId  String   @unique
  eventType     String
  payload       Json
  processed     Boolean  @default(false)
  processedAt   DateTime?
  createdAt     DateTime @default(now())
}
